# Generated by replygirl/kuru release tooling. Update in the source repository.
class Kuru < Formula
  desc "Persistent equal-part chat harness with isolated memories"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "MIT"

  on_macos do
    depends_on arch: :arm64
    on_arm do
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/kuru-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@MAC_ARM_CORE@"
      resource "shell-support" do
        url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/kuru-@VERSION@-aarch64-apple-darwin-shell-support.tar.gz"
        sha256 "@MAC_ARM_SUPPORT@"
      end
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/kuru-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@LINUX_ARM_CORE@"
      resource "shell-support" do
        url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/kuru-@VERSION@-aarch64-unknown-linux-gnu-shell-support.tar.gz"
        sha256 "@LINUX_ARM_SUPPORT@"
      end
    end
    on_intel do
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/kuru-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@LINUX_INTEL_CORE@"
      resource "shell-support" do
        url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/kuru-@VERSION@-x86_64-unknown-linux-gnu-shell-support.tar.gz"
        sha256 "@LINUX_INTEL_SUPPORT@"
      end
    end
  end

  skip_clean "bin/kuru"
  deny_network_access! [:build, :test]

  def install
    odie "Kuru supports only native Apple Silicon and Linux ARM64/x86-64" unless
      (OS.mac? && Hardware::CPU.arm?) || (OS.linux? && (Hardware::CPU.arm? || Hardware::CPU.intel?))
    bin.install "kuru"
    pkgshare.install "LICENSE", "README.md"
    resource("shell-support").stage do
      bash_completion.install "completions/kuru.bash" => "kuru"
      zsh_completion.install "completions/_kuru"
      fish_completion.install "completions/kuru.fish"
      pwsh_completion.install "completions/kuru.ps1"
      man1.install "man/kuru.1"
    end
  end

  test do
    assert_equal "kuru #{version}\n", shell_output("#{bin}/kuru --version")
    assert_match "NAME", shell_output("#{bin}/kuru man")
    assert_match "kuru", shell_output("#{bin}/kuru completions zsh")
    assert_match "brew upgrade kuru", shell_output("#{bin}/kuru update --version #{version} --release-base https://example.invalid/kuru 2>&1", 1)
  end
end
